<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.11hopem.ai-sleep-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/umut/mycodespaces/mac-anti-sleep/scripts/ai-sleep-guard</string>
        <string>daemon</string>
    </array>

    <!-- Run automatically on boot/login and keep alive continuously -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/umut/mycodespaces/mac-anti-sleep</string>

    <key>StandardOutPath</key>
    <string>/Users/umut/Library/Logs/mac-anti-sleep/daemon_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/umut/Library/Logs/mac-anti-sleep/daemon_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/umut/.local/bin</string>
        <key>HOME</key>
        <string>/Users/umut</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
